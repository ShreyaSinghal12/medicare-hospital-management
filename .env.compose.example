# Copy to .env (git-ignored) for docker compose. Use long random values; never reuse the development ones.
DB_USERNAME=medicare_app
DB_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-to-another-long-random-password
# The public HTTPS address of the site (used in e-mail links and as the only allowed CORS origin)
PUBLIC_URL=https://localhost
SESSION_TIMEOUT=30m
# Real SMTP is needed for password-reset and account-setup e-mails
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@medicare.example
# First administrator (created once, when no administrator exists; receives a set-your-password e-mail)
BOOTSTRAP_ADMIN_EMAIL=admin@your-hospital.example
BOOTSTRAP_ADMIN_NAME=Administrator
