# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit real credentials.

# --- MySQL (development database) ---
DB_URL=jdbc:mysql://localhost:3306/medicare_db?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useUnicode=true&characterEncoding=utf8
DB_USERNAME=medicare_user
DB_PASSWORD=change-me

# --- MySQL (integration-test database; tests wipe nothing outside it) ---
TEST_DB_URL=jdbc:mysql://localhost:3306/medicare_test?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
TEST_DB_USERNAME=medicare_user
TEST_DB_PASSWORD=change-me

# --- Server ---
SERVER_PORT=8080
SESSION_TIMEOUT=30m
# true when running behind HTTPS
COOKIE_SECURE=false
FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated list of exact origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
UPLOAD_DIR=./uploads

# --- E-mail (MAIL_ENABLED=false => in-app notifications only, no SMTP needed) ---
MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@medicare.example
